-- WIN TRIGGER SYSTEM
----------------------------------------------------
triggerWin = function(player)
	if isProcessingAnswer then return end
	isProcessingAnswer = true
	quizActive = false
	optionsAllowed = false
	
	local userId = player.UserId
	playerScores[userId] = (playerScores[userId] or 0) + 10
	playerNames[userId] = player.DisplayName 
	
	logInfo("Player " .. player.Name .. " answered correctly!")
	sendChatMessage("🎉 " .. player.DisplayName .. " Correct answer! (+10 Pts) 🎉")
	currentQuestionIndex += 1
	
	task.wait(2)
	
	if currentQuestionIndex > #quizDatabase then 
		task.spawn(showLeaderboard)
	else
		isProcessingAnswer = false
		task.spawn(askNextQuestion)
	end
end

----------------------------------------------------
-- ANSWER PARSING & CHAT LISTENER LOGIC
----------------------------------------------------
local function onPlayerChatted(player, message)
	if not QuizConfig.IsRunning or not quizActive or isProcessingAnswer then return end
	
	-- Blacklist & Spammer Ignore check
	local playerNameUpper = string.upper(player.Name)
	local playerDisplayNameUpper = string.upper(player.DisplayName)
	if blacklistedPlayers[playerNameUpper] or blacklistedPlayers[playerDisplayNameUpper] then
		return
	end
    
    if QuizConfig.IgnoredPlayers[player.Name:lower()] or QuizConfig.IgnoredPlayers[player.DisplayName:lower()] then
        return -- Ignored Spammer
    end
	
	local rawTrimmed = string.match(message, "^%s*(.-)%s*$")
	if not rawTrimmed then return end
	
	local upperMsg = string.upper(rawTrimmed)
	local cleanMsg = string.gsub(upperMsg, "[^%w]", "")
	
	local matchedLetter = string.match(upperMsg, "^([A-D])$") or string.match(upperMsg, "^([A-D])[%-%._%)%:]+$")
	
	if matchedLetter then
		-- OPTIONS CHECK: Allowed only if mode has Options enabled
		if not QuizConfig.WithOptions or not optionsAllowed then return end
		
		if hasGuessedOption[player.UserId] then 
			return 
		end
		
		hasGuessedOption[player.UserId] = true 
		
		if matchedLetter == correctAnswer then
			triggerWin(player)
		else
			return
		end
	else
		-- DIRECT WORD CHECK: Allowed instantly
		local currentQuiz = quizDatabase[currentQuestionIndex]
		local possibleWords = {}
		if currentQuiz then
			table.insert(possibleWords, string.upper(string.gsub(currentQuiz.WordAnswer, "[^%w]", "")))
			if currentQuiz.WordAnswer == "BLUE WHALE" then
				table.insert(possibleWords, "BLUEWHALE")
			elseif currentQuiz.WordAnswer == "LEONARDO DA VINCI" then
				table.insert(possibleWords, "LEONARDODAVINCI")
			end
		end
		
		local isCorrectWord = false
		for _, w in ipairs(possibleWords) do
			if cleanMsg == w then
				isCorrectWord = true
				break
			end
		end
		
		if isCorrectWord then
			triggerWin(player)
		else
			return
		end
	end
end

----------------------------------------------------
-- CHAT SYSTEM HOOK INITIALIZATION
----------------------------------------------------
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	local conn = TextChatService.MessageReceived:Connect(function(textMessage) 
		if textMessage.TextSource then
			local targetPlayer = Players:GetPlayerByUserId(textMessage.TextSource.UserId) 
			if targetPlayer then 
				onPlayerChatted(targetPlayer, textMessage.Text) 
			end 
		end
	end)
    table.insert(QuizConfig.Connections, conn)
else
	local function hookPlayerInstance(plr)
		local conn = plr.Chatted:Connect(function(chatMsg)
			onPlayerChatted(plr, chatMsg)
		end)
        table.insert(QuizConfig.Connections, conn)
	end

	local connAdded = Players.PlayerAdded:Connect(hookPlayerInstance)
    table.insert(QuizConfig.Connections, connAdded)
    
	for _, existingPlayer in ipairs(Players:GetPlayers()) do
		hookPlayerInstance(existingPlayer)
	end
end

----------------------------------------------------
-- QUESTION FLOW MANAGEMENT
----------------------------------------------------
askNextQuestion = function()
	if not QuizConfig.IsRunning then return end

	if currentQuestionIndex > #quizDatabase then
		showLeaderboard()
		return
	end

	local currentQuiz = quizDatabase[currentQuestionIndex]
	correctAnswer = string.upper(string.gsub(currentQuiz.Answer, "[^%w]", ""))
	currentWordAnswer = string.upper(string.gsub(currentQuiz.WordAnswer, "[^%w]", ""))
	
	questionSession += 1
	local currentSession = questionSession
	
	hasGuessedOption = {} 
	quizActive = true
	optionsAllowed = false 
	isProcessingAnswer = false
	
	logInfo("Asking question index: " .. currentQuestionIndex)
	
	-- 1. Direct Word open notification comes FIRST
	sendChatMessage("💡 Direct Word Guessing is OPEN NOW! (Unlimited Tries)")
	
	if not smartWait(TIMING_DIRECT_OPEN_DELAY) then return end 
	if not quizActive or questionSession ~= currentSession then return end
	
	-- 2. Broadcast the Question Text
	sendChatMessage(currentQuiz.Question)
	
	-- 3. Question Reading Phase (Uses dynamic ReadTime from GUI!)
	if not smartWait(QuizConfig.ReadTime) then return end 
	if not quizActive or questionSession ~= currentSession then return end
	
	-- 4. OPTIONS HANDLING (Checks if 'WITH OPTIONS' mode is active in GUI)
    if QuizConfig.WithOptions then
        optionsAllowed = true
        for _, optionText in ipairs(currentQuiz.Options) do 
            sendChatMessage(optionText)
            if not smartWait(TIMING_OPTION_GAP) then return end 
            if not quizActive or questionSession ~= currentSession then return end
        end
    else
        optionsAllowed = false
    end
	
	if not smartWait(TIMING_ANSWER_WAIT) then return end 
	
	if quizActive and questionSession == currentSession then
		quizActive = false
		optionsAllowed = false
		sendChatMessage("⏳ Time's up! Correct answer was: " .. correctAnswer .. " (" .. currentWordAnswer .. ")")
		currentQuestionIndex += 1
		
		task.wait(TIMING_POST_ANSWER)
		
		if currentQuestionIndex <= #quizDatabase then 
			task.spawn(askNextQuestion) 
		else
			task.spawn(showLeaderboard) 
		end
	end
end

