-- LEADERBOARD SYSTEM
----------------------------------------------------
showLeaderboard = function()
	quizActive = false
	optionsAllowed = false
	
	logInfo("Displaying final leaderboard for JEE Mock Test 2.")
	sendChatMessage("📊 --- JEE 2027 MOCK TEST 2 FINAL LEADERBOARD ---")
	if not smartWait(4) then destroyGUIAndStop() return end
	
	local sortedScores = {}
	for userId, score in pairs(playerScores) do
		table.insert(sortedScores, {name = playerNames[userId] or "Unknown", score = score})
	end
	
	table.sort(sortedScores, function(a, b) 
		return a.score > b.score 
	end)
	
	if #sortedScores == 0 then
		sendChatMessage("Nobody scored any points! 😢")
	else
		for rank, data in ipairs(sortedScores) do
			sendChatMessage("🏅 Rank " .. rank .. ": " .. data.name .. " - " .. data.score .. " Pts")
			if not smartWait(3) then destroyGUIAndStop() return end
		end
	end
	
	if not smartWait(4) then destroyGUIAndStop() return end
	sendChatMessage("📢 Mock test finished! All rights reserved to NOT_IITIAN! 🛡️⭐")
    
    -- Auto Destroy UI when quiz finishes naturally
    destroyGUIAndStop()
end

----------------------------------------------------
-- WIN TRIGGER SYSTEM
----------------------------------------------------
triggerWin = function(player)
	if isProcessingAnswer then return end
	isProcessingAnswer = true
	quizActive = false
	optionsAllowed = false
	
	local userId = player.UserId
	playerScores[userId] = (playerScores[userId] or 0) + 10
	playerNames[userId] = player.DisplayName 
	
	logInfo("Player " .. player.Name .. " answered correctly!")
	sendChatMessage("🎉 " .. player.DisplayName .. " Correct answer! (+10 Pts) 🎉")
	currentQuestionIndex += 1
	
	task.wait(2)
	
	if currentQuestionIndex > #quizDatabase then 
		task.spawn(showLeaderboard)
	else
		isProcessingAnswer = false
		task.spawn(askNextQuestion)
	end
end

----------------------------------------------------
-- ANSWER PARSING & CHAT LISTENER LOGIC
----------------------------------------------------
local function onPlayerChatted(player, message)
	if not QuizConfig.IsRunning or not quizActive or isProcessingAnswer then return end
	
	-- Blacklist & Spammer Ignore check
	local playerNameUpper = string.upper(player.Name)
	local playerDisplayNameUpper = string.upper(player.DisplayName)
	if blacklistedPlayers[playerNameUpper] or blacklistedPlayers[playerDisplayNameUpper] then
		return
	end
    
    if QuizConfig.IgnoredPlayers[player.Name:lower()] or QuizConfig.IgnoredPlayers[player.DisplayName:lower()] then
        return -- Ignored Spammer
    end
	
	local rawTrimmed = string.match(message, "^%s*(.-)%s*$")
	if not rawTrimmed then return end
	
	local upperMsg = string.upper(rawTrimmed)
	local cleanMsg = string.gsub(upperMsg, "[^%w]", "")
	
	local matchedLetter = string.match(upperMsg, "^([A-D])$") or string.match(upperMsg, "^([A-D])[%-%._%)%:]+$")
	
	if matchedLetter then
		-- OPTIONS CHECK: Allowed only if mode has Options enabled
		if not QuizConfig.WithOptions or not optionsAllowed then return end
		
		if hasGuessedOption[player.UserId] then 
			return 
		end
		
		hasGuessedOption[player.UserId] = true 
		
		if matchedLetter == correctAnswer then
			triggerWin(player)
		else
			return
		end
	else
		-- DIRECT WORD CHECK: Allowed instantly
		if cleanMsg == currentWordAnswer then
			triggerWin(player)
		else
			return
		end
	end
end

